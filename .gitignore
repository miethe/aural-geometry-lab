# --- build / tooling ---
node_modules/
dist/
.DS_Store
*.log
coverage/
.build/
.swiftpm/

# --- Agentic OS (AOS) artifact layer ---------------------------------------
# Treated exactly like a package manager's tree:
#
#   COMMITTED (the manifest + the lockfile — reproducibility inputs):
#     .claude/aos-artifacts.yaml        <- package.json  (what this project declares)
#     .claude/.skillmeat-deployed.toml  <- package-lock  (what was deployed, with content hashes)
#     .claude/settings.json             <- project tool config
#     CLAUDE.md / AGENTS.md             <- project context, hand-authored
#
#   IGNORED (the installed packages — reproducible, never hand-edited):
#     everything below. Restore with the commands in .claude/aos-artifacts.yaml's header.
#
# Edit an artifact at its UPSTREAM, never at the deployed copy here.
.claude/skills/
.claude/agents/
.claude/commands/
.claude/workflows/
.claude/hooks/
.claude/context/
.claude/mcp/
.claude/orchestration/

# machine-local state (absolute paths, server UUIDs, per-user overrides)
.claude/settings.local.json
.claude/.skillmeat-project.toml
.claude/.aos-writeback-state
.claude/*.skillmeat-lock
.claude/**/.*.skillmeat-lock
.skillmeat/

# AOS rule files — hand-copied because skillmeat cannot deploy type rule_file (pending PR #422).
# NEVER PUBLISH: all 12 carry LAN addresses, credential paths, IntentTree node ids and incident
# narratives. This repository is PUBLIC. See .claude/rules/README-PROVENANCE.md.
.claude/rules/
.scratch/
.operator/

# AGL-149 mockup campaign — provider transcripts and local report artifacts.
# The .log files are raw delegate stdout: 1.3 MB of noise, and a demonstrated egress
# channel — a codex leg echoed its own ~/.codex/memories/MEMORY.md into the transcript,
# carrying the AOS LAN address and IntentTree node ids. This repository is PUBLIC.
# The images, prompts, harness, and critique.json ARE committed; the transcripts are not.
design/mockups/**/*.log
design/mockups/images/.run-*.out
design/mockups/campaign.log

# Agent working area: delivery-report renders and manifests. Local artifacts that
# reference .claude/ paths and internal tracker ids; the durable reports live in docs/.
.claude/reports/
