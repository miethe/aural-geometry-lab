{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auralgeometrylab.local/schemas/agl-command-v1.schema.json",
  "title": "Aural Geometry Lab Semantic Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "commandId", "transactionId", "logicalActionId", "projectEpoch", "kind", "payloadVersion", "payload", "preconditions", "origin", "actor"],
  "properties": {
    "schema": { "const": "agl.command" },
    "schemaVersion": { "const": 1 },
    "commandId": { "type": "string", "minLength": 1 },
    "transactionId": { "type": "string", "minLength": 1 },
    "logicalActionId": { "type": "string", "minLength": 1 },
    "projectEpoch": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "payloadVersion": { "type": "integer", "minimum": 1 },
    "payload": {},
    "preconditions": { "type": "array", "items": { "type": "object", "required": ["kind"] } },
    "origin": { "enum": ["user", "undo", "redo", "migration", "system"] },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "sequence"],
      "properties": { "actorId": { "type": "string" }, "sequence": { "type": "string", "pattern": "^[0-9]+$" } }
    },
    "coalescing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editSessionId", "targetSetDigest", "writeSetDigest"],
      "properties": {
        "editSessionId": { "type": "string" },
        "targetSetDigest": { "type": "string" },
        "writeSetDigest": { "type": "string" }
      }
    }
  }
}
