{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auralgeometrylab.local/schemas/agl-package-manifest-v1.schema.json",
  "title": "Aural Geometry Lab Logical Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "logicalProfile", "physicalProfile", "projectSchemaVersion", "projectSemanticId", "saveGeneration", "projectSemanticDigest", "members", "compatibility"],
  "properties": {
    "schema": { "const": "agl.package.manifest" },
    "schemaVersion": { "const": 1 },
    "logicalProfile": { "const": "agl.logical-package.v1" },
    "physicalProfile": { "enum": ["agl.native-directory-package.v1", "agl.portable-archive.v1"] },
    "projectSchemaVersion": { "type": "integer", "minimum": 1 },
    "projectSemanticId": { "type": "string", "minLength": 1 },
    "saveGeneration": { "type": "string", "minLength": 1 },
    "projectSemanticDigest": { "type": "string", "minLength": 1 },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumReaderVersion", "requiredOperatorCatalogVersion"],
      "properties": {
        "minimumReaderVersion": { "type": "string", "minLength": 1 },
        "requiredOperatorCatalogVersion": { "type": "string", "minLength": 1 }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "mediaType", "authoritative"],
        "properties": {
          "path": { "type": "string", "pattern": "^(project\\.json|assets/[A-Za-z0-9._/-]+|preview/[A-Za-z0-9._/-]+|research-receipts/[A-Za-z0-9._/-]+)$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string", "minLength": 1 },
          "authoritative": { "type": "boolean" }
        }
      }
    }
  }
}
