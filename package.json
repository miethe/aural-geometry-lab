{
  "name": "aural-geometry-lab",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "FR-01-hardened Aural Geometry Lab contracts, executable foundations, research evidence, and cross-platform conformance system.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run clean && npm run build && npm run test && npm run schema:validate && npm run verify",
    "verify": "node scripts/verify.mjs",
    "figures": "node scripts/build-figures.mjs",
    "check:all": "node scripts/check-all.mjs",
    "schema:validate": "python3 scripts/validate-json-schemas.py",
    "release:archive": "python3 scripts/make-release.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
